const carouselItems = [...logoItems, ...logoItems, ...logoItems];

const projects = [
  {
    title: "Understanding Cancer Metastasis",
    org: "The Peter MacCallum Cancer Centre",
    copy:
      "Spent the last 5 years studying how breast cancer spreads to the lungs and brain. Used single-cell and spatial transcriptomics to map how cells changed during this process, and developed new protein-based drugs aimed at stopping it.",
    stats: [
      ["Coffee drank", "Alot"],
      ["Year", "2025"],
    ],
    image: "/images/svi-logo.jpg",
    accent: "95, 130, 83",
  },
  {
    title: "Building an AI Teaching Assistant",
    org: "Sindy Labs",
    copy:
      "Founded, built, recruited and raised while completing my PhD in cancer research. Backed by Berkeley SkyDeck.",
    stats: [
      ["Raised", "$500k"],
      ["Year", "2025"],
    ],
    image: "/images/sindy-team-updated.png",
    accent: "123, 77, 38",
  },
  {
    title: "Lecturing & Mentoring",
    org: "ACU & Unimelb",
    copy:
      "Taught subjects in biotech and immunology to undergraduate and post-graduate students across the Melbourne Biomedical Precinct.",
    stats: [
      ["Lessons Taught", "50+"],
      ["Years", "5"],
    ],
    image: "/images/lecture.jpg",
    accent: "95, 72, 120",
  },
  {
    title: "Hackathons & Competitions",
    org: "Local & International",
    copy:
      "Awarded over $200K in competitive grants and prizes through hackathons and pitch competitions. Recognised by organisations like Heidi Health, Google Cloud, MedTech Actuator, and UC Berkeley. Finalist in 3MT, multiple-time university pitch winner, and recipient of scholarships with <1 to 10% acceptance rates.",
    stats: [
      ["No. Awards/ Prizes", "24+"],
      ["Cumulative Prize Pool", "$200k+"],
    ],
    image: "/images/hackathon.jpg",
    accent: "35, 93, 120",
  },
];

const ventures = [
  ["Founder & Scientist", "Puulp™", "2026 – Present"],
  ["Senior Product Strategist", "Appetiser Apps", "2025 – 2026"],
  ["Doctoral Candidate", "The Peter MacCallum Cancer Centre", "2021 - 2025"],
  ["Medical Research Scientist", "St. Vincent's Institute", "2020 - Present"],
  ["Lecturer / Demonstrator", "Australian Catholic University", "2019 - Present"],
  ["Co-Founder", "Sindy Labs (prev. Sincidium)", "2023 - 2024"],
];

const skillGroups = [
  {
    title: "Technical",
    items: [
      "Molecular Biology",
      "Immunology",
      "Microbiology",
      "Target Discovery",
      "Transcriptomics",
      "Protein Design & Development",
      "In Vivo Disease Models",
      "Oncology",
      "In Vitro Models",
      "Microsurgery",
      "Data Analysis",
      "C",
      "Basic Python",
      "+ More",
    ],
  },
  {
    title: "Operator",
    items: [
      "Fundraising",
      "Storytelling",
      "Go-to-Market Planning",
      "Talent Acquisition",
      "Product Strategy/ UX",
      "Product Management",
      "Experimental Design",
      "Scientific Writing",
      "Grant Applications",
      "Ethics Applications",
      "Interviewing",
