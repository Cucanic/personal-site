---
import "../styles/global.css";

const navItems = ["Home", "About", "Projects", "Experiences", "Podcasts", "Contact"];
const contactUrl = "https://www.linkedin.com/in/olivercucanic";
const siteTitle = "Oliver Cucanic: Home";
const siteDescription =
  "Oliver Cucanic is a scientist and startup founder who enjoys building things from scratch. This site showcases his research, projects, and early-stage work.";

const logoItems = [
  {
    label: "Australian Catholic University",
    detail: "Lectured Biomedical Science students on biotechnology and immunology.",
    src: "/images/logo-mark.png",
    href: "https://www.acu.edu.au/",
    scale: 1.06,
  },
  {
    label: "Peter MacCallum Cancer Centre",
    detail: "Studied how breast cancer spreads to the lung and brain.",
    src: "/images/acu-logo.webp",
    href: "https://www.petermac.org/research/research-programs-and-labs/cancer-evolution-and-metastasis-program-lab/steven-stacker-lab",
    scale: 1.04,
  },
  {
    label: "Sindy Labs",
    detail: "Created an AI-powered digital teacher's assistant.",
    src: "/images/petermac-logo.png",
    href: "https://www.businessnewsaustralia.com/articles/melbourne-founded-digital-teaching-assistant-sindy-ai-accepted-into-berkeley-skydeck-accelerator.html",
    scale: 1.12,
  },
  {
    label: "The University of Melbourne",
    detail: "Completed my PhD in cancer biology.",
    src: "/images/sindy-logo.png",
    href: "https://about.unimelb.edu.au/facts-and-figures",
    scale: 1.28,
  },
  {
    label: "Podcasting",
    detail: "Interviewed top Australian founders, investors, and researchers.",
    src: "/images/unimelb-logo.png",
    href: "https://insaneambition.beehiiv.com/",
    scale: 1.42,
  },
  {
    label: "University of California, Berkeley",
    detail: "Completed a 6-month accelerator led by top Silicon Valley VCs and operators.",
    src: "/images/extra-logo.png",
    href: "https://skydeck.berkeley.edu/",
    scale: 1.14,
  },
  {
    label: "St Vincent's Institute",
    detail: "Prepared insulin-producing cells for Type 1 Diabetes therapy.",
    src: "/images/berkeley-logo.png",
