---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href="https://www.cucanic.com/" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content="https://www.cucanic.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.cucanic.com/images/oliver-headshot-highres.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true">
      <span class="fluid-blob fluid-blob-one"></span>
      <span class="fluid-blob fluid-blob-two"></span>
      <span class="fluid-blob fluid-blob-three"></span>
      <span class="fluid-blob fluid-blob-four"></span>
      <span class="fluid-blob fluid-blob-five"></span>
      <span class="fluid-blob fluid-blob-six"></span>
    </div>

    <header class="site-header">
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="#home" aria-label="Oliver Cucanic home" class="brand-link">
          <img src="/images/dna-logo.png" alt="" width="512" height="512" />
        </a>
        <div class="nav-center">
          {navItems.slice(0, -1).map((item) => <a href={`#${item.toLowerCase()}`}>{item}</a>)}
        </div>
        <a class="contact-pill" href={contactUrl} target="_blank" rel="noreferrer">Contact</a>
      </nav>
    </header>

    <main id="home">
      <section class="hero-section">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-inner">
          <img class="portrait" src="/images/oliver-headshot-highres.png" alt="Oliver Cucanic" />
          <div class="role-badge">
            <img class="role-badge-mark" src="/images/pill-icon.png" alt="" width="512" height="512" />
            Cellular & Molecular Biologist
          </div>
          <h1 class="hero-title">
            Hi I'm Oliver. Trained in science, now building things.
          </h1>
          <p class="hero-copy">
            I spent a decade studying disease to understand how health fails. Then I moved into building products to learn how real-world impact actually happens. Today, I focus on creating things that improve people's lives at scale.
          </p>
          <a href={contactUrl} class="hero-cta" target="_blank" rel="noreferrer">Let's Connect</a>
        </div>
      </section>

      <section id="about" class="logo-section">
        <div class="logo-carousel" aria-label="Experience logos">
          <div class="logo-track">
          {carouselItems.map((item) => (
            <a class="logo-tile" href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.label}: ${item.detail}`} style={`--logo-scale: ${item.scale};`}>
              <img src={item.src} alt="" loading="lazy" />
              <span class="logo-caption">
                <strong>{item.label}</strong>
                <em>{item.detail}</em>
              </span>
            </a>
          ))}
          </div>
        </div>
        <h2 id="projects">Things That Kept Me Up at Night</h2>
      </section>

      <section class="project-stack" aria-label="Selected projects">
        {projects.map((project, index) => (
          <article class="project-card" style={`--accent: ${project.accent}; --i: ${index};`}>
            <div class="project-copy">
              <h3>{project.title}</h3>
              <p class="project-org">{project.org}</p>
              <p>{project.copy}</p>
            </div>
            <div class="project-media">
              <img src={project.image} alt="" loading="lazy" />
              <div class="project-stats">
                {project.stats.map(([label, value]) => (
                  <div>
                    <span>{label}</span>
                    <strong>{value}</strong>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))}
      </section>

      <section class="summary-line">
        <p>
          Researcher and operator in <span>Oncology & Genomics</span> with over <span>9 years</span> of applied scientific experience.
        </p>
      </section>

      <section id="experiences" class="ventures-section">
        <h2>Most Recent Ventures</h2>
        <div class="venture-list">
          {ventures.map(([role, company, years]) => (
            <article class="venture-row">
              <h3>{role}</h3>
              <div>
                <p>{company}</p>
                <span>{years}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="skills-section">
        <h2>Skills I Picked Up Along the Way</h2>
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.title}</h3>
            <div class="skill-list">
              {group.items.map((skill) => <span>{skill}</span>)}
            </div>
          </div>
        ))}
      </section>

      <section id="podcasts" class="podcast-section">
        <div class="section-heading">
          <h2>Conversations I Never Thought I'd Have</h2>
          <a href="https://www.youtube.com/watch?v=pPM1_qnMQfE" target="_blank" rel="noreferrer">See More</a>
        </div>
        <article class="podcast-row">
          <a class="podcast-thumb" href="https://www.youtube.com/watch?v=pPM1_qnMQfE" target="_blank" rel="noreferrer" aria-label="Watch podcast episode">
            <img src="/images/podcast-thumb.webp" alt="Courage and tenacity: the story of Reebok with Joe Foster" loading="lazy" />
            <span aria-hidden="true"></span>
          </a>
          <div>
            <p>April, 2024</p>
            <h3>
              Spoke with Joe Foster (<strong>Founder of Reebok</strong>) about building a multi-billion dollar shoe empire, rivaling Nike, and selling the company to Adidas.
            </h3>
          </div>
        </article>
      </section>

      <section class="quote-section" aria-label="Personal quote">
        <p class="footer-quote">Be impatient with actions & patient with results. When you feel passionate, take action immediately.</p>
      </section>
    </main>

    <footer id="contact" class="site-footer">
      <div>
        <p>© Oliver Cucanic 2025.</p>
        <a href={contactUrl} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </footer>
    <div class="cursor-glow" aria-hidden="true"></div>
    <script>
      const cursorGlow = document.querySelector(".cursor-glow");
      if (cursorGlow && window.matchMedia("(pointer: fine)").matches) {
        let x = window.innerWidth / 2;
        let y = window.innerHeight / 2;
        let targetX = x;
        let targetY = y;

        window.addEventListener("pointermove", (event) => {
          targetX = event.clientX;
          targetY = event.clientY;
        });

        const render = () => {
          x += (targetX - x) * 0.42;
          y += (targetY - y) * 0.42;
          cursorGlow.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
          requestAnimationFrame(render);
        };

        render();
      }
    </script>
  </body>
</html>
